{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/web/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.codestream.ai"
  },
  "regions": ["iad1"],
  "functions": {
    "apps/web/**/*.js": {
      "maxDuration": 10
    }
  }
}
